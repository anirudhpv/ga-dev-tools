
modules = ["nodejs-20", "web"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "yarn start:app:production"]

[workflows]
runButton = "Dev Server"

[[workflows.workflow]]
name = "Dev Server"
author = 42992143
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "yarn"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd lib && yarn && cd .."

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "yarn start:app:production"
